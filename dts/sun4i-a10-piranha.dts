// SPDX-License-Identifier: GPL-2.0+
/*
 * Piranha Business II Tab (Softwinners "crane" / crane-a702jhorange)
 * Allwinner A10 (sun4i) · 1 GB DDR3 · AXP209 · 800x480 starry,kr070pe2t
 * Goodix GT811 dokunmatik (i2c2 @0x5D) · RTL8188CUS USB WiFi
 *
 * Topwise A721 (Pascal Roeleven, 2020) temel alındı. Farklar:
 *   - dokunmatik: FT5406@0x38 yerine GT827@0x5D
 *   - usb_otg: dr_mode = "host"  (UART yok, USB klavye ilk boot'ta şart)
 *   - HDMI etkin (panel çalışmazsa tek teşhis kanalı)
 */

/dts-v1/;
#include "sun4i-a10.dtsi"
#include "sunxi-common-regulators.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pwm/pwm.h>

/ {
	model = "Piranha Business II Tab (A10 crane)";
	compatible = "softwinners,crane", "topwise,a721", "allwinner,sun4i-a10";

	aliases {
		serial0 = &uart0;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 100000 PWM_POLARITY_INVERTED>;
		power-supply = <&reg_vbat>;
		enable-gpios = <&pio 7 7 GPIO_ACTIVE_HIGH>; /* PH7 */
		brightness-levels = <0 30 40 50 60 70 80 90 100>;
		default-brightness-level = <8>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* fex lcd0_para ile birebir: 800x480, 33MHz, hbp46/vbp23 */
	panel: panel {
		compatible = "starry,kr070pe2t";
		backlight = <&backlight>;
		power-supply = <&reg_lcd_power>;

		port {
			panel_input: endpoint {
				remote-endpoint = <&tcon0_out_panel>;
			};
		};
	};

	/* HDMI yedek çıkış — UART olmadığı için teşhis kanalı */
	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	reg_lcd_power: reg-lcd-power {
		compatible = "regulator-fixed";
		regulator-name = "reg-lcd-power";
		gpio = <&pio 7 8 GPIO_ACTIVE_HIGH>; /* PH8 */
		enable-active-high;
	};

	reg_vbat: reg-vbat {
		compatible = "regulator-fixed";
		regulator-name = "vbat";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
	};
};

&codec {
	/* Android/FEX: audio_pa_ctrl = port:PA10 */
	allwinner,pa-gpios = <&pio 0 10 GPIO_ACTIVE_HIGH>; /* PA10 */
	status = "okay";
};

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

&de {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&hdmi {
	status = "okay";
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&i2c0 {
	status = "okay";

	axp209: pmic@34 {
		reg = <0x34>;
		interrupts = <0>;
	};
};

#include "axp209.dtsi"

&ac_power_supply {
	status = "okay";
};

&battery_power_supply {
	status = "okay";
};

&i2c1 {
	status = "okay";

	/* fex: dmard06 @0x1c + mma7660 @0x4c ikisi de listede, sysfs ikisini de gösteriyor */
	accelerometer@4c {
		compatible = "fsl,mma7660";
		reg = <0x4c>;
	};
};

&i2c2 {
	status = "okay";

	/*
	 * Goodix GT827 @ 0x5D — HANDOFF (2026-08-20) kesin: çip GT827,
	 * GT811 DEĞİL. INT = PH21, RESET = PB13 (fex ctp_*_b).
	 * fex: revert_y=1, exchange_x_y=1
	 *
	 * mainline goodix.c GT9xx ailesi — GT827'yi desteklemez. Out-of-tree
	 * gt827.ko (drivers/input/touchscreen/gt827.c) yüklenince bind olur.
	 * Yüklenmezse düğüm sessizce bağlanmaz — boot'u ETKİLEMEZ.
	 */
	touchscreen@5d {
		compatible = "goodix,gt827";
		reg = <0x5d>;
		interrupt-parent = <&pio>;
		interrupts = <7 21 IRQ_TYPE_EDGE_FALLING>;   /* PH21 */
		reset-gpios = <&pio 1 13 GPIO_ACTIVE_HIGH>;  /* PB13 */
		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;
		touchscreen-swapped-x-y;
		touchscreen-inverted-y;
		vcc-supply = <&reg_vcc3v3>;
		status = "okay";
	};
};

&lradc {
	vref-supply = <&reg_ldo2>;
	status = "okay";

	button-571 {
		label = "Volume Up";
		linux,code = <KEY_VOLUMEUP>;
		channel = <0>;
		voltage = <571428>;
	};

	button-761 {
		label = "Volume Down";
		linux,code = <KEY_VOLUMEDOWN>;
		channel = <0>;
		voltage = <761904>;
	};
};

&mmc0 {
	vmmc-supply = <&reg_vcc3v3>;
	bus-width = <4>;
	cd-gpios = <&pio 7 1 GPIO_ACTIVE_LOW>; /* PH1 */
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&otg_sram {
	status = "okay";
};

&pio {
	vcc-pb-supply = <&reg_vcc3v3>;
	vcc-pf-supply = <&reg_vcc3v3>;
	vcc-ph-supply = <&reg_vcc3v3>;
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pin>;
	status = "okay";
};

&reg_dcdc2 {
	regulator-always-on;
	regulator-min-microvolt = <1000000>;
	regulator-max-microvolt = <1400000>;
	regulator-name = "vdd-cpu";
};

&reg_dcdc3 {
	regulator-always-on;
	regulator-min-microvolt = <1250000>;
	regulator-max-microvolt = <1250000>;
	regulator-name = "vdd-int-dll";
};

&reg_ldo1 {
	regulator-name = "vdd-rtc";
};

&reg_ldo2 {
	regulator-always-on;
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	regulator-name = "avcc";
};

&reg_usb0_vbus {
	status = "okay";
};

&reg_usb1_vbus {
	status = "okay";
};

&reg_usb2_vbus {
	status = "okay";
};

&tcon0_out {
	tcon0_out_panel: endpoint@0 {
		reg = <0>;
		remote-endpoint = <&panel_input>;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};

/*
 * OTG: hem host (USB klavye/mouse) hem gadget (g_ether USB-Ethernet) çalışsın.
 * dr_mode="host" iken gadget tarafı devre dışı kalıyordu (usb0 oluşmuyordu).
 * ID-pin algılaması kartta çalışmasa da, g_ether modülü gadget'ı zorlar.
 * Eski nota: A721'de otg idi ama ID-pin sorunu yüzünden klavye çalışmadı;
 * bunu çözmek için usb0_id_det-gpios (PH4) tanımlı.
 */
&usb_otg {
	dr_mode = "otg";
	status = "okay";
};

&usb_power_supply {
	status = "okay";
};

&usbphy {
	usb0_id_det-gpios = <&pio 7 4 GPIO_ACTIVE_HIGH>; /* PH4 */
	usb0_vbus_det-gpios = <&pio 7 5 GPIO_ACTIVE_HIGH>; /* PH5 */
	usb0_vbus-supply = <&reg_usb0_vbus>;
	usb1_vbus-supply = <&reg_usb1_vbus>;
	usb2_vbus-supply = <&reg_usb2_vbus>;
	status = "okay";
};
